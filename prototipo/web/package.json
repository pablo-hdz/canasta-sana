    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@tesseract.js-data/spa": "1.0.0",
    "pdfjs-dist": "4.8.69",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.4.6",
    "vitest": "5.1.0"
  }
}
