{
  "name": "canasta-sana",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Prototipo de Canasta sana: tiquete del súper → sellos OPS → qué conviene cambiar y qué buscar (sin sugerir productos ni precios, D-23). Datos SIMULADO salvo la base de Open Food Facts.",
  "scripts": {
    "ocr:copiar": "node scripts/copiar-ocr.mjs",
